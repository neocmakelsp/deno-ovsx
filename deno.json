    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
    "@libs/xml": "jsr:@libs/xml@^7.0.4",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@nobody/deno-clap": "jsr:@nobody/deno-clap@^0.2.11",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.30",
    "@std/fmt": "jsr:@std/fmt@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@vscode/vsce": "npm:@vscode/vsce@^3.9.1",
